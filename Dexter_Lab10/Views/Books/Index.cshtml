@model List<Book>
@{
    ViewData["Title"] = "Library Books Catalogue";
}

<div class="p-4 mb-4 bg-light rounded-3 shadow-sm border">
    <div class="container-fluid py-2 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold text-primary">📚 Library Books</h1>
            <p class="fs-5 text-muted mb-0">Total active titles in inventory: <strong>@Model.Count</strong></p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">➕ Add a book</a>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-primary text-uppercase fs-7">
                <tr>
                    <th class="text-end ps-4" style="width:5rem"># ID</th>
                    <th>Book Title</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-end pe-4" style="width:12rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td class="text-end ps-4 fw-bold text-secondary">@book.BookId</td>
                        <td class="fw-semibold text-dark">@book.Title</td>
                        <td><span class="badge rounded-pill bg-info text-dark px-3 py-2">@(book.Category ?? "—")</span></td>
                        <td class="text-end fw-bold text-success">@(book.Price?.ToString("N2") ?? "—")</td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-warning text-dark px-2 me-1">✏️ Edit</a>
                            <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-danger px-2">🗑️ Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>