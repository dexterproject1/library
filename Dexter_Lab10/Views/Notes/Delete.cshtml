@model library.Models.Note
@{
    ViewData["Title"] = "Delete Note";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-danger border-0 rounded-3">
            <div class="card-body p-4">
                <h2 class="card-title text-danger mb-3 font-weight-bold">Delete Note</h2>
                <p class="text-muted mb-4">Are you sure you want to delete this note? This action cannot be undone.</p>

                <div class="bg-light p-3 rounded mb-4">
                    <h5 class="font-weight-bold mb-2">@Model.Title</h5>
                    <p class="mb-0 text-secondary">@(Model.Body ?? "No body text provided.")</p>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="NoteId" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">Delete Note</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>