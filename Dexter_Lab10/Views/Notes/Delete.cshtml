@model Note
@{
    ViewData["Title"] = "Delete a note";
}
<h1>Delete a note</h1>
<div class="card card-body" style="max-width:36rem">
    <p>Are you sure you want to delete this note?</p>
    <p><strong>@Model.Title</strong></p>
    <form asp-action="Delete" asp-route-id="@Model.NoteId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>