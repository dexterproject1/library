@model List<library.Models.Note>
@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Notes Dashboard</h1>
        <p class="text-muted mb-0">Manage your quick notes and reminders</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm px-3">Add a note</a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Title</th>
                    <th>Body</th>
                    <th>Created On</th>
                    <th class="text-end pe-4" style="width:12rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var note in Model)
                {
                    <tr>
                        <td class="ps-4 fw-medium text-dark">@note.Title</td>
                        <td class="text-muted text-truncate" style="max-width: 250px;">@(note.Body ?? "—")</td>
                        <td>@note.CreatedOn.ToString("yyyy-MM-dd")</td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@note.NoteId" class="btn btn-sm btn-outline-secondary px-2 me-1">Edit</a>
                            <a asp-action="Delete" asp-route-id="@note.NoteId" class="btn btn-sm btn-outline-danger px-2">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>