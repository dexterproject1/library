@model Note
@{
    ViewData["Title"] = "Add a note";
}
<h1>Add a note</h1>
<form asp-action="Create" method="post" class="card card-body" style="max-width:36rem">
    <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Body" class="form-label"></label><textarea asp-for="Body" class="form-control"></textarea></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>