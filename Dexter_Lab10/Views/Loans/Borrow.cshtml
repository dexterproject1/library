@model BorrowForm
@{
    ViewData["Title"] = "Borrow a Book";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow border-0 rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <h1 class="h3 fw-bold text-dark">Borrow a Book</h1>
                    <p class="text-muted small">Record a new book loan transaction securely.</p>
                </div>

                <form asp-action="Borrow" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="MemberId" class="form-label fw-semibold">Member</label>
                        <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select form-select-lg fs-6">
                            <option value="">(Choose a member)</option>
                        </select>
                        <span asp-validation-for="MemberId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BookId" class="form-label fw-semibold">Book</label>
                        <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select form-select-lg fs-6">
                            <option value="">(Choose a book)</option>
                        </select>
                        <span asp-validation-for="BookId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DaysAllowed" class="form-label fw-semibold">Days Allowed</label>
                        <input asp-for="DaysAllowed" class="form-control form-control-lg fs-6" />
                        <span asp-validation-for="DaysAllowed" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg py-2 shadow-sm">Confirm Borrow</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}