@model List<Member>
@{
    ViewData["Title"] = "Library Members Directory";
}

<div class="p-4 mb-4 bg-dark text-white rounded-3 shadow">
    <div class="container-fluid py-2 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold text-warning">👤 Library Members</h1>
            <p class="fs-5 text-light opacity-75 mb-0">Registered system members: <strong>@Model.Count</strong></p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-warning btn-lg fw-semibold shadow-sm text-dark">➕ Add a member</a>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark text-uppercase fs-7">
                <tr>
                    <th class="text-end ps-4" style="width:5rem"># ID</th>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>Membership Type</th>
                    <th class="text-end pe-4" style="width:12rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr>
                        <td class="text-end ps-4 fw-bold text-secondary">@member.MemberId</td>
                        <td class="fw-semibold text-dark">@member.FullName</td>
                        <td><span class="text-muted">@(member.Email ?? "—")</span></td>
                        <td>
                            @if (member.MemberType == "Faculty")
                            {
                                <span class="badge bg-danger px-3 py-2">Faculty</span>
                            }
                            else if (member.MemberType == "Student")
                            {
                                <span class="badge bg-success px-3 py-2">Student</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">Regular</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-warning text-dark px-2 me-1">✏️ Edit</a>
                            <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger px-2">🗑️ Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>