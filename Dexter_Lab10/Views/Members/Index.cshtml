@model List<library.Models.Member>
@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Members</h1>
    <a asp-action="Create" class="btn btn-primary">Add Member</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Member Type</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var member in Model)
            {
                <tr>
                    <td>@member.FullName</td>
                    <td>@(member.Email ?? "—")</td>
                    <td><span class="badge text-bg-secondary">@member.MemberType</span></td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>