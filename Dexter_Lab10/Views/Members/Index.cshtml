@model List<library.Models.Member>
@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Library Members</h1>
        <p class="text-muted mb-0">@Model.Count registered members</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm px-3">Add Member</a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>Email</th>
                    <th>Member Type</th>
                    <th class="text-end pe-4" style="width:12rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@member.FullName</td>
                            <td class="text-muted">@(member.Email ?? "—")</td>
                            <td><span class="badge bg-secondary px-2 py-1">@member.MemberType</span></td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-secondary px-2 me-1">Edit</a>
                                <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger px-2">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>