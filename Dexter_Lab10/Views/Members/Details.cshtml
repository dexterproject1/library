@model MemberDetails
@{
    ViewData["Title"] = Model.Member.FullName;
}

<div class="container py-4">
    <div class="card shadow-sm border-0 rounded-4 p-4 mb-4 bg-light">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">@Model.Member.FullName</h1>
                <p class="text-muted mb-0">
                    <span class="badge bg-secondary me-2">@Model.Member.MemberType</span>
                    <span>@(Model.Member.Email ?? "No email provided")</span>
                </p>
            </div>
            <a asp-action="Index" class="btn btn-outline-dark btn-sm px-3">Back to Members</a>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 fw-bold text-dark mb-0">Loan History</h2>
        <span class="badge bg-primary rounded-pill px-3 py-2">Total Loans: @Model.Loans.Count</span>
    </div>

    @if (Model.Loans.Count == 0)
    {
        <div class="alert alert-info border-0 shadow-sm rounded-3 py-4 text-center text-muted">
            This member has never borrowed a book.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-uppercase fs-7">
                        <tr>
                            <th class="py-3 ps-4">Book Title</th>
                            <th class="py-3">Loaned Date</th>
                            <th class="py-3">Returned Date</th>
                            <th class="py-3 pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model.Loans)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@loan.BookTitle</td>
                                <td>@loan.LoanedOn.ToString("yyyy-MM-dd")</td>
                                <td>@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td class="pe-4">
                                    <span class="badge px-3 py-2 @(loan.Status == "Overdue" ? "bg-danger text-white" : loan.Status == "Out" ? "bg-warning text-dark" : "bg-success text-white")">
                                        @loan.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>